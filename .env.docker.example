# SERVER uchun namuna (Docker). Serverda:  cp .env.docker.example .env  va to'ldiring.
# Local Windows'dagi .env (SQLite) bilan aralashtirmang.

# --- Domen va SSL ---
DOMAIN=imkon-plus.uz
SSL_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=nnp
POSTGRES_USER=nnp
# Uzun tasodifiy parol:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Django ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=imkon-plus.uz,www.imkon-plus.uz,backend,localhost
CSRF_TRUSTED_ORIGINS=https://imkon-plus.uz,https://www.imkon-plus.uz
# nginx X-Forwarded-For qo'shadi — bitta ishonchli proxy
NUM_PROXIES=1
LOG_LEVEL=INFO

# --- Telegram ---
# @BotFather tokeni (Web App initData tekshiruvi uchun) — parranda_bot/.env dagi bilan BIR XIL
BOT_TOKEN=
# Bot bilan umumiy maxfiy kalit — parranda_bot/.env dagi BOT_API_TOKEN bilan BIR XIL
BOT_API_TOKEN=
