# Copy to .env and fill in the values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Telegram bot token from @BotFather (used to validate Telegram Web App initData).
# Empty -> POST /api/auth/telegram always answers 401.
BOT_TOKEN=
# Shared secret with parranda_bot (sent in the X-Bot-Token header).
# Empty -> every /api/bot/... endpoint answers 403.
BOT_API_TOKEN=
# Optional, comma separated, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=
# Trusted proxies appending to X-Forwarded-For (login throttle client IP). 0 = REMOTE_ADDR only.
NUM_PROXIES=1
# Optional SQLite file (default: db.sqlite3 next to manage.py), e.g. a disposable copy for tests.
# DB_PATH=
# Optional: PostgreSQL instead of SQLite (needs `pip install psycopg[binary]`), e.g.
# DATABASE_URL=postgres://nnp:password@127.0.0.1:5432/nnp?sslmode=disable
# CONN_MAX_AGE=60
# Log level of the project's own loggers (nnp.*): DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
